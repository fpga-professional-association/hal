set(LINUX @LINUX@)
set(ENABLE_INSTALL_LDCONFIG @ENABLE_INSTALL_LDCONFIG@)
set(MANIFEST "${CMAKE_CURRENT_BINARY_DIR}/install_manifest.txt")

if(NOT EXISTS ${MANIFEST})
    message(FATAL_ERROR "Cannot find install manifest: '${MANIFEST}'")
endif()

file(STRINGS ${MANIFEST} files)
foreach(file ${files})
    if(EXISTS ${file})
        message(STATUS "Removing file: '${file}'")

        exec_program(
                ${CMAKE_COMMAND} ARGS "-E remove ${file}"
                OUTPUT_VARIABLE stdout
                RETURN_VALUE result
        )

        if(NOT "${result}" STREQUAL 0)
            message(FATAL_ERROR "Failed to remove file: '${file}'.")
        endif()
    else()
        message(STATUS "File '${file}' does not exist.")
    endif()
endforeach(file)

# Mirror image of cmake/post_install.cmake.in: only undo the system-level part of the install if this
# install actually did it. A staged install (DESTDIR) never wrote /etc/ld.so.conf.d/hal.conf, and
# removing another installation's file from here would be wrong.
if(ENABLE_INSTALL_LDCONFIG AND LINUX)
    if(NOT "$ENV{DESTDIR}" STREQUAL "")
        message(STATUS "hal: DESTDIR is set to '$ENV{DESTDIR}' - leaving /etc/ld.so.conf.d/hal.conf alone")
    elseif(NOT EXISTS "/etc/ld.so.conf.d/hal.conf")
        message(STATUS "hal: /etc/ld.so.conf.d/hal.conf does not exist, nothing to remove")
    else()
        message(STATUS "hal: removing /etc/ld.so.conf.d/hal.conf")
        execute_process(COMMAND ${CMAKE_COMMAND} -E remove /etc/ld.so.conf.d/hal.conf RESULT_VARIABLE remove_result ERROR_VARIABLE remove_error)
        if(NOT remove_result EQUAL 0)
            message(WARNING "hal: could not remove /etc/ld.so.conf.d/hal.conf (${remove_error}), run the uninstall as root")
        else()
            message(STATUS "hal: running ldconfig")
            execute_process(COMMAND "ldconfig" RESULT_VARIABLE ldconfig_result ERROR_VARIABLE ldconfig_error)
            if(NOT ldconfig_result EQUAL 0)
                message(WARNING "hal: ldconfig failed (${ldconfig_error})")
            endif()
        endif()
    endif()
endif()
