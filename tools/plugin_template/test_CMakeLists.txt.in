if(BUILD_TESTS)
    include_directories(${gtest_SOURCE_DIR}/include ${gtest_SOURCE_DIR} ${CMAKE_SOURCE_DIR}/include ${CMAKE_SOURCE_DIR}/tests ${CMAKE_SOURCE_DIR}/plugins/##LOWER##/include)

    add_executable(runTest-##LOWER## ##LOWER##.cpp)

    target_link_libraries(runTest-##LOWER## ##LOWER## pthread gtest hal::core hal::netlist test_utils)

    add_test(runTest-##LOWER## ${CMAKE_BINARY_DIR}/bin/hal_plugins/runTest-##LOWER## --gtest_output=xml:${CMAKE_BINARY_DIR}/gtestresults-runTest-##LOWER##.xml)

    if(${CMAKE_BUILD_TYPE} STREQUAL "Debug")
        add_sanitizers(runTest-##LOWER##)
    endif()
endif()
