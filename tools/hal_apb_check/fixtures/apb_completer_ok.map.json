{
  "mapping_version": "1.0",
  "name": "apb_completer_ok",
  "description": "APB4 completer with one wait state; the correct completer fixture.",
  "protocol": {
    "family": "APB",
    "revision": "APB4",
    "dut_role": "completer"
  },
  "design": {
    "netlist": "apb_completer_ok.v",
    "gate_library": "../../../plugins/gate_libraries/definitions/example_library.hgl"
  },
  "clock": {
    "signal": "PCLK",
    "edge": "rising"
  },
  "reset": {
    "signal": "PRESETn",
    "active_low": true,
    "cycles": 2
  },
  "signals": {
    "PRESETn": "PRESETn",
    "PSEL": "PSEL",
    "PENABLE": "PENABLE",
    "PWRITE": "PWRITE",
    "PADDR": ["PADDR_0"],
    "PWDATA": ["PWDATA_0"],
    "PREADY": "PREADY",
    "PRDATA": ["PRDATA_0"],
    "PSLVERR": "PSLVERR"
  },
  "options": {
    "bound": 12,
    "max_wait_states": 4
  }
}
