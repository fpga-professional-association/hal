{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fpga-professional-association/hal/tools/hal_analysis_api/schema/analysis-api-1.0.0.schema.json",
  "title": "HAL analysis API 1.0.0",
  "description": "Request and response schemas for every tool of tools/hal_analysis_api. A request is validated before anything runs, and every response is validated before it is returned, so a schema violation is a bug report rather than a surprise at the caller.",
  "$defs": {
    "api_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "envelope": {
      "type": "object",
      "description": "Every answer this API gives. Exactly one of result/error is present.",
      "required": ["ok", "api_version", "tool"],
      "additionalProperties": false,
      "properties": {
        "ok": {"type": "boolean"},
        "api_version": {"$ref": "#/$defs/api_version"},
        "tool": {"type": "string"},
        "result": {"type": "object"},
        "error": {"$ref": "#/$defs/error"}
      },
      "if": {"properties": {"ok": {"const": true}}, "required": ["ok"]},
      "then": {"required": ["result"]},
      "else": {"required": ["error"]}
    },
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "invalid_request",
            "unknown_tool",
            "unknown_project",
            "unknown_object",
            "unknown_analysis",
            "unknown_job",
            "unknown_artifact",
            "not_ready",
            "limit_exceeded",
            "timeout",
            "hal_unavailable",
            "hal_error",
            "internal"
          ]
        },
        "message": {"type": "string", "minLength": 1},
        "detail": {"type": "string"},
        "hint": {"type": "string"},
        "data": {"type": "object"}
      }
    },
    "project_id": {
      "type": "string",
      "pattern": "^prj-[0-9a-f]{12}$",
      "description": "A project handle from project.open. Handles are content-derived: the same path with the same content always yields the same handle."
    },
    "job_id": {
      "type": "string",
      "pattern": "^job-[0-9a-f]{12}$"
    },
    "offset": {"type": "integer", "minimum": 0},
    "page": {
      "type": "object",
      "description": "Where a listing was cut. has_more/next_offset exist so a caller never has to do the arithmetic itself.",
      "required": ["offset", "limit", "returned", "total", "has_more", "next_offset"],
      "additionalProperties": false,
      "properties": {
        "offset": {"type": "integer", "minimum": 0},
        "limit": {"type": "integer", "minimum": 1},
        "returned": {"type": "integer", "minimum": 0},
        "total": {"type": "integer", "minimum": 0},
        "has_more": {"type": "boolean"},
        "next_offset": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "truncation": {
      "type": "object",
      "description": "Whether a bounded traversal was cut short. Present on every result that could be, with truncated=false when it was not.",
      "required": ["truncated", "reason", "limit", "kind"],
      "additionalProperties": false,
      "properties": {
        "truncated": {"type": "boolean"},
        "reason": {"type": ["string", "null"]},
        "limit": {"type": ["integer", "null"]},
        "kind": {"type": ["string", "null"]}
      }
    },
    "gate_ref": {
      "type": "object",
      "required": ["id", "name", "type"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "integer"},
        "name": {"type": "string"},
        "type": {"type": "string"},
        "module_id": {"type": ["integer", "null"]},
        "module_name": {"type": ["string", "null"]},
        "properties": {"type": "array", "items": {"type": "string"}}
      }
    },
    "net_ref": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "integer"},
        "name": {"type": "string"},
        "is_global_input": {"type": "boolean"},
        "is_global_output": {"type": "boolean"},
        "source_count": {"type": "integer", "minimum": 0},
        "destination_count": {"type": "integer", "minimum": 0}
      }
    },
    "module_ref": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "integer"},
        "name": {"type": "string"},
        "type": {"type": ["string", "null"]},
        "parent_id": {"type": ["integer", "null"]},
        "gate_count": {"type": "integer", "minimum": 0},
        "submodule_count": {"type": "integer", "minimum": 0}
      }
    },
    "endpoint": {
      "type": "object",
      "description": "One pin of one gate on one net.",
      "required": ["pin", "direction"],
      "additionalProperties": false,
      "properties": {
        "pin": {"type": "string"},
        "direction": {"type": "string", "enum": ["input", "output"]},
        "net": {
          "description": "the net on this pin, or null when the pin is unconnected",
          "anyOf": [{"$ref": "#/$defs/net_ref"}, {"type": "null"}]
        },
        "gate": {
          "description": "the gate on the other side of this endpoint, or null when it leaves the netlist",
          "anyOf": [{"$ref": "#/$defs/gate_ref"}, {"type": "null"}]
        }
      }
    },
    "gate_detail": {
      "type": "object",
      "required": ["id", "name", "type", "fan_in", "fan_out", "truncation"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "integer"},
        "name": {"type": "string"},
        "type": {"type": "string"},
        "module_id": {"type": ["integer", "null"]},
        "module_name": {"type": ["string", "null"]},
        "properties": {"type": "array", "items": {"type": "string"}},
        "is_gnd": {"type": "boolean"},
        "is_vcc": {"type": "boolean"},
        "fan_in": {"type": "array", "items": {"$ref": "#/$defs/endpoint"}},
        "fan_out": {"type": "array", "items": {"$ref": "#/$defs/endpoint"}},
        "fan_in_total": {"type": "integer", "minimum": 0},
        "fan_out_total": {"type": "integer", "minimum": 0},
        "truncation": {"$ref": "#/$defs/truncation"}
      }
    },
    "net_detail": {
      "type": "object",
      "required": ["id", "name", "sources", "destinations", "truncation"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "integer"},
        "name": {"type": "string"},
        "is_global_input": {"type": "boolean"},
        "is_global_output": {"type": "boolean"},
        "sources": {"type": "array", "items": {"$ref": "#/$defs/endpoint"}},
        "destinations": {"type": "array", "items": {"$ref": "#/$defs/endpoint"}},
        "source_count": {"type": "integer", "minimum": 0},
        "destination_count": {"type": "integer", "minimum": 0},
        "truncation": {"$ref": "#/$defs/truncation"}
      }
    },
    "edge": {
      "type": "object",
      "required": ["from_gate_id", "to_gate_id", "net_id"],
      "additionalProperties": false,
      "properties": {
        "from_gate_id": {"type": "integer"},
        "to_gate_id": {"type": "integer"},
        "net_id": {"type": "integer"},
        "net_name": {"type": "string"},
        "from_pin": {"type": ["string", "null"]},
        "to_pin": {"type": ["string", "null"]}
      }
    },
    "project_info": {
      "type": "object",
      "required": ["project", "path", "kind", "digest", "opened_at"],
      "additionalProperties": false,
      "properties": {
        "project": {"$ref": "#/$defs/project_id"},
        "path": {"type": "string", "description": "the path as the caller gave it"},
        "resolved_path": {"type": "string"},
        "netlist_path": {"type": "string", "description": "what the in-HAL side actually loads (a project archive is unpacked into the workspace)"},
        "kind": {"type": "string", "enum": ["hal_project_dir", "hal_project_archive", "hal_netlist", "hdl_netlist"]},
        "gate_library": {"type": ["string", "null"]},
        "label": {"type": ["string", "null"]},
        "digest": {
          "type": "object",
          "required": ["algorithm", "value"],
          "additionalProperties": false,
          "properties": {
            "algorithm": {"type": "string"},
            "value": {"type": "string"},
            "file_count": {"type": ["integer", "null"]},
            "size_bytes": {"type": ["integer", "null"]}
          }
        },
        "opened_at": {"type": "string"},
        "read_only": {"type": "boolean", "const": true}
      }
    },
    "analysis_info": {
      "type": "object",
      "required": ["name", "plugin", "deterministic", "method_kind", "options"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "plugin": {"type": "string"},
        "entry_point": {"type": "string"},
        "deterministic": {"type": "boolean"},
        "method_kind": {"type": "string"},
        "method_name": {"type": "string"},
        "description": {"type": "string"},
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "types", "default", "description"],
            "additionalProperties": false,
            "properties": {
              "name": {"type": "string"},
              "types": {"type": "array", "items": {"type": "string"}},
              "default": {},
              "description": {"type": "string"},
              "choices": {"type": ["array", "null"]},
              "minimum": {"type": ["number", "null"]}
            }
          }
        }
      }
    },
    "job_status": {
      "type": "object",
      "required": ["job", "project", "analysis", "state", "submitted_at"],
      "additionalProperties": false,
      "properties": {
        "job": {"$ref": "#/$defs/job_id"},
        "project": {"$ref": "#/$defs/project_id"},
        "analysis": {"type": "string"},
        "label": {"type": ["string", "null"]},
        "state": {
          "type": "string",
          "enum": ["queued", "running", "succeeded", "failed", "timeout", "cancelled", "lost"],
          "description": "'lost' means the worker process disappeared without recording an outcome -- reported explicitly rather than left as 'running' forever."
        },
        "terminal": {"type": "boolean"},
        "config": {"type": "object"},
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "timeout_s": {"type": ["integer", "null"]},
            "memory_mb": {"type": ["integer", "null"]}
          }
        },
        "submitted_at": {"type": "string"},
        "started_at": {"type": ["string", "null"]},
        "finished_at": {"type": ["string", "null"]},
        "duration_s": {"type": ["number", "null"]},
        "exit_code": {"type": ["integer", "null"]},
        "step_status": {"type": ["string", "null"]},
        "findings_counts": {"type": ["object", "null"]},
        "findings_source": {"type": ["string", "null"], "enum": ["findings", "diagnostic", null]},
        "run_dir": {"type": "string"},
        "run_config_path": {"type": "string"},
        "manifest_path": {"type": ["string", "null"]},
        "error": {"type": ["object", "null"]},
        "waited_s": {"type": ["number", "null"]},
        "wait_timed_out": {"type": ["boolean", "null"]}
      }
    },
    "artifact_entry": {
      "type": "object",
      "required": ["path", "role", "size_bytes"],
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string", "description": "relative to the job directory"},
        "role": {"type": "string"},
        "description": {"type": ["string", "null"]},
        "sha256": {"type": ["string", "null"]},
        "size_bytes": {"type": "integer", "minimum": 0}
      }
    },

    "req_hal_capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "res_hal_capabilities": {
      "type": "object",
      "required": ["api_version", "schema_version", "tools", "analyses", "limits", "hal", "workspace"],
      "additionalProperties": false,
      "properties": {
        "api_version": {"$ref": "#/$defs/api_version"},
        "schema_version": {"type": "string"},
        "findings_schema_version": {"type": "string"},
        "runner_version": {"type": "string"},
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "summary", "mutates", "requires_hal"],
            "additionalProperties": false,
            "properties": {
              "name": {"type": "string"},
              "summary": {"type": "string"},
              "mutates": {"type": "string", "enum": ["nothing", "session", "job"]},
              "requires_hal": {"type": "boolean"},
              "paginated": {"type": "boolean"}
            }
          }
        },
        "analyses": {"type": "array", "items": {"$ref": "#/$defs/analysis_info"}},
        "limits": {"type": "object"},
        "error_codes": {"type": "object"},
        "hal": {
          "type": "object",
          "required": ["available"],
          "additionalProperties": false,
          "properties": {
            "available": {"type": "boolean"},
            "binary": {"type": ["string", "null"]},
            "reason": {"type": ["string", "null"]}
          }
        },
        "workspace": {"type": "string"},
        "optional_integrations": {"type": "object"},
        "notes": {"type": "array", "items": {"type": "string"}}
      }
    },

    "req_hal_schema": {
      "type": "object",
      "required": ["tool"],
      "additionalProperties": false,
      "properties": {"tool": {"type": "string"}}
    },
    "res_hal_schema": {
      "type": "object",
      "required": ["tool", "request_schema", "response_schema"],
      "additionalProperties": false,
      "properties": {
        "tool": {"type": "string"},
        "summary": {"type": "string"},
        "request_schema": {"type": "object"},
        "response_schema": {"type": "object"}
      }
    },

    "req_project_open": {
      "type": "object",
      "required": ["path"],
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string", "minLength": 1, "description": "HAL project directory, project .zip, .hal file, or an HDL netlist (which then needs gate_library)"},
        "gate_library": {"type": ["string", "null"]},
        "label": {"type": ["string", "null"], "maxLength": 120}
      }
    },
    "res_project_open": {
      "type": "object",
      "required": ["project", "reused", "info"],
      "additionalProperties": false,
      "properties": {
        "project": {"$ref": "#/$defs/project_id"},
        "reused": {"type": "boolean", "description": "true when this exact path and content was already open under the same handle"},
        "info": {"$ref": "#/$defs/project_info"}
      }
    },

    "req_project_list": {"type": "object", "additionalProperties": false, "properties": {}},
    "res_project_list": {
      "type": "object",
      "required": ["projects", "count"],
      "additionalProperties": false,
      "properties": {
        "projects": {"type": "array", "items": {"$ref": "#/$defs/project_info"}},
        "count": {"type": "integer", "minimum": 0}
      }
    },

    "req_project_describe": {
      "type": "object",
      "required": ["project"],
      "additionalProperties": false,
      "properties": {"project": {"$ref": "#/$defs/project_id"}}
    },
    "res_project_describe": {
      "type": "object",
      "required": ["info"],
      "additionalProperties": false,
      "properties": {
        "info": {"$ref": "#/$defs/project_info"},
        "still_matches_digest": {"type": ["boolean", "null"], "description": "null when re-hashing was skipped; false means the file changed since it was opened and every earlier answer is about different content"}
      }
    },

    "req_project_close": {
      "type": "object",
      "required": ["project"],
      "additionalProperties": false,
      "properties": {"project": {"$ref": "#/$defs/project_id"}}
    },
    "res_project_close": {
      "type": "object",
      "required": ["project", "closed"],
      "additionalProperties": false,
      "properties": {
        "project": {"$ref": "#/$defs/project_id"},
        "closed": {"type": "boolean"},
        "note": {"type": ["string", "null"]}
      }
    },

    "req_netlist_summary": {
      "type": "object",
      "required": ["project"],
      "additionalProperties": false,
      "properties": {
        "project": {"$ref": "#/$defs/project_id"},
        "max_gate_types": {"type": "integer", "minimum": 1, "maximum": 256},
        "timeout_s": {"type": "integer", "minimum": 1, "maximum": 3600}
      }
    },
    "res_netlist_summary": {
      "type": "object",
      "required": ["project", "design_name", "counts", "gate_types", "truncation"],
      "additionalProperties": false,
      "properties": {
        "project": {"$ref": "#/$defs/project_id"},
        "design_name": {"type": ["string", "null"]},
        "netlist_id": {"type": ["integer", "null"]},
        "device_name": {"type": ["string", "null"]},
        "gate_library": {"type": ["string", "null"]},
        "top_module": {"anyOf": [{"$ref": "#/$defs/module_ref"}, {"type": "null"}]},
        "counts": {
          "type": "object",
          "required": ["gates", "nets", "modules"],
          "additionalProperties": false,
          "properties": {
            "gates": {"type": "integer", "minimum": 0},
            "nets": {"type": "integer", "minimum": 0},
            "modules": {"type": "integer", "minimum": 0},
            "gate_types": {"type": "integer", "minimum": 0},
            "global_inputs": {"type": "integer", "minimum": 0},
            "global_outputs": {"type": "integer", "minimum": 0}
          }
        },
        "gate_types": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "count"],
            "additionalProperties": false,
            "properties": {
              "type": {"type": "string"},
              "count": {"type": "integer", "minimum": 0}
            }
          }
        },
        "truncation": {"$ref": "#/$defs/truncation"},
        "query": {"type": "object"}
      }
    },

    "req_netlist_gates": {
      "type": "object",
      "required": ["project"],
      "additionalProperties": false,
      "properties": {
        "project": {"$ref": "#/$defs/project_id"},
        "name_contains": {"type": ["string", "null"], "maxLength": 200, "description": "case-insensitive substring of the gate name"},
        "gate_type": {"type": ["string", "null"], "maxLength": 200, "description": "exact gate type name, as reported by netlist.summary"},
        "module_id": {"type": ["integer", "null"], "description": "only the gates of this module, not those of its submodules"},
        "offset": {"$ref": "#/$defs/offset"},
        "limit": {"type": "integer", "minimum": 1, "maximum": 500},
        "timeout_s": {"type": "integer", "minimum": 1, "maximum": 3600}
      }
    },
    "res_netlist_gates": {
      "type": "object",
      "required": ["project", "gates", "page"],
      "additionalProperties": false,
      "properties": {
        "project": {"$ref": "#/$defs/project_id"},
        "gates": {"type": "array", "items": {"$ref": "#/$defs/gate_ref"}},
        "page": {"$ref": "#/$defs/page"},
        "filters": {"type": "object"},
        "query": {"type": "object"}
      }
    },

    "req_netlist_nets": {
      "type": "object",
      "required": ["project"],
      "additionalProperties": false,
      "properties": {
        "project": {"$ref": "#/$defs/project_id"},
        "name_contains": {"type": ["string", "null"], "maxLength": 200},
        "global_only": {"type": "boolean"},
        "offset": {"$ref": "#/$defs/offset"},
        "limit": {"type": "integer", "minimum": 1, "maximum": 500},
        "timeout_s": {"type": "integer", "minimum": 1, "maximum": 3600}
      }
    },
    "res_netlist_nets": {
      "type": "object",
      "required": ["project", "nets", "page"],
      "additionalProperties": false,
      "properties": {
        "project": {"$ref": "#/$defs/project_id"},
        "nets": {"type": "array", "items": {"$ref": "#/$defs/net_ref"}},
        "page": {"$ref": "#/$defs/page"},
        "filters": {"type": "object"},
        "query": {"type": "object"}
      }
    },

    "req_netlist_modules": {
      "type": "object",
      "required": ["project"],
      "additionalProperties": false,
      "properties": {
        "project": {"$ref": "#/$defs/project_id"},
        "name_contains": {"type": ["string", "null"], "maxLength": 200},
        "offset": {"$ref": "#/$defs/offset"},
        "limit": {"type": "integer", "minimum": 1, "maximum": 500},
        "timeout_s": {"type": "integer", "minimum": 1, "maximum": 3600}
      }
    },
    "res_netlist_modules": {
      "type": "object",
      "required": ["project", "modules", "page"],
      "additionalProperties": false,
      "properties": {
        "project": {"$ref": "#/$defs/project_id"},
        "modules": {"type": "array", "items": {"$ref": "#/$defs/module_ref"}},
        "page": {"$ref": "#/$defs/page"},
        "filters": {"type": "object"},
        "query": {"type": "object"}
      }
    },

    "req_netlist_gate": {
      "type": "object",
      "required": ["project", "gate_id"],
      "additionalProperties": false,
      "properties": {
        "project": {"$ref": "#/$defs/project_id"},
        "gate_id": {"type": "integer"},
        "max_endpoints": {"type": "integer", "minimum": 1, "maximum": 1000},
        "timeout_s": {"type": "integer", "minimum": 1, "maximum": 3600}
      }
    },
    "res_netlist_gate": {
      "type": "object",
      "required": ["project", "gate"],
      "additionalProperties": false,
      "properties": {
        "project": {"$ref": "#/$defs/project_id"},
        "gate": {"$ref": "#/$defs/gate_detail"},
        "query": {"type": "object"}
      }
    },

    "req_netlist_net": {
      "type": "object",
      "required": ["project", "net_id"],
      "additionalProperties": false,
      "properties": {
        "project": {"$ref": "#/$defs/project_id"},
        "net_id": {"type": "integer"},
        "max_endpoints": {"type": "integer", "minimum": 1, "maximum": 1000},
        "timeout_s": {"type": "integer", "minimum": 1, "maximum": 3600}
      }
    },
    "res_netlist_net": {
      "type": "object",
      "required": ["project", "net"],
      "additionalProperties": false,
      "properties": {
        "project": {"$ref": "#/$defs/project_id"},
        "net": {"$ref": "#/$defs/net_detail"},
        "query": {"type": "object"}
      }
    },

    "req_netlist_cone": {
      "type": "object",
      "required": ["project", "seed_gate_ids"],
      "additionalProperties": false,
      "properties": {
        "project": {"$ref": "#/$defs/project_id"},
        "seed_gate_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {"type": "integer"}
        },
        "direction": {"type": "string", "enum": ["fan_in", "fan_out", "both"]},
        "depth": {"type": "integer", "minimum": 0, "maximum": 32},
        "max_gates": {"type": "integer", "minimum": 1, "maximum": 2000},
        "include_edges": {"type": "boolean"},
        "timeout_s": {"type": "integer", "minimum": 1, "maximum": 3600}
      }
    },
    "res_netlist_cone": {
      "type": "object",
      "required": ["project", "seed_gate_ids", "direction", "depth", "gates", "truncation", "counts"],
      "additionalProperties": false,
      "properties": {
        "project": {"$ref": "#/$defs/project_id"},
        "seed_gate_ids": {"type": "array", "items": {"type": "integer"}},
        "direction": {"type": "string", "enum": ["fan_in", "fan_out", "both"]},
        "depth": {"type": "integer", "minimum": 0},
        "reached_depth": {"type": "integer", "minimum": 0},
        "gates": {"type": "array", "items": {"$ref": "#/$defs/gate_ref"}},
        "edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}},
        "counts": {
          "type": "object",
          "required": ["gates"],
          "additionalProperties": false,
          "properties": {
            "gates": {"type": "integer", "minimum": 0},
            "edges": {"type": "integer", "minimum": 0},
            "frontier": {"type": "integer", "minimum": 0}
          }
        },
        "truncation": {"$ref": "#/$defs/truncation"},
        "query": {"type": "object"}
      }
    },

    "req_analysis_list": {"type": "object", "additionalProperties": false, "properties": {}},
    "res_analysis_list": {
      "type": "object",
      "required": ["analyses"],
      "additionalProperties": false,
      "properties": {
        "analyses": {"type": "array", "items": {"$ref": "#/$defs/analysis_info"}},
        "runner_version": {"type": "string"},
        "registry_version": {"type": "string"}
      }
    },

    "req_analysis_submit": {
      "type": "object",
      "required": ["project", "analysis"],
      "additionalProperties": false,
      "properties": {
        "project": {"$ref": "#/$defs/project_id"},
        "analysis": {"type": "string"},
        "config": {"type": "object"},
        "timeout_s": {"type": "integer", "minimum": 1, "maximum": 86400},
        "memory_mb": {"type": "integer", "minimum": 1},
        "label": {"type": ["string", "null"], "maxLength": 120}
      }
    },
    "res_analysis_submit": {
      "type": "object",
      "required": ["job", "status"],
      "additionalProperties": false,
      "properties": {
        "job": {"$ref": "#/$defs/job_id"},
        "status": {"$ref": "#/$defs/job_status"}
      }
    },

    "req_analysis_status": {
      "type": "object",
      "required": ["job"],
      "additionalProperties": false,
      "properties": {
        "job": {"$ref": "#/$defs/job_id"},
        "wait_s": {"type": "number", "minimum": 0, "maximum": 300, "description": "block until the job is terminal or this many seconds pass; a wait that expires is reported as wait_timed_out, not as an error"}
      }
    },
    "res_analysis_status": {
      "type": "object",
      "required": ["status"],
      "additionalProperties": false,
      "properties": {"status": {"$ref": "#/$defs/job_status"}}
    },

    "req_analysis_cancel": {
      "type": "object",
      "required": ["job"],
      "additionalProperties": false,
      "properties": {"job": {"$ref": "#/$defs/job_id"}}
    },
    "res_analysis_cancel": {
      "type": "object",
      "required": ["job", "cancelled", "status"],
      "additionalProperties": false,
      "properties": {
        "job": {"$ref": "#/$defs/job_id"},
        "cancelled": {"type": "boolean"},
        "reason": {"type": ["string", "null"]},
        "status": {"$ref": "#/$defs/job_status"}
      }
    },

    "req_analysis_jobs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project": {"type": ["string", "null"]},
        "state": {"type": ["string", "null"]},
        "offset": {"$ref": "#/$defs/offset"},
        "limit": {"type": "integer", "minimum": 1, "maximum": 500}
      }
    },
    "res_analysis_jobs": {
      "type": "object",
      "required": ["jobs", "page"],
      "additionalProperties": false,
      "properties": {
        "jobs": {"type": "array", "items": {"$ref": "#/$defs/job_status"}},
        "page": {"$ref": "#/$defs/page"}
      }
    },

    "req_findings_get": {
      "type": "object",
      "required": ["job"],
      "additionalProperties": false,
      "properties": {
        "job": {"$ref": "#/$defs/job_id"},
        "status": {"type": ["string", "null"], "description": "keep only findings with this findings-schema status"},
        "offset": {"$ref": "#/$defs/offset"},
        "limit": {"type": "integer", "minimum": 1, "maximum": 200}
      }
    },
    "res_findings_get": {
      "type": "object",
      "required": ["job", "source", "schema_version", "findings", "page", "counts"],
      "additionalProperties": false,
      "properties": {
        "job": {"$ref": "#/$defs/job_id"},
        "source": {
          "type": "string",
          "enum": ["findings", "diagnostic"],
          "description": "'diagnostic' is the record hal_runner writes for a step that timed out or failed -- a real findings document, never a substitute for one"
        },
        "schema_version": {"type": "string"},
        "digest": {"type": ["string", "null"]},
        "producer": {"type": ["object", "null"]},
        "analysis": {"type": ["object", "null"]},
        "artifacts": {"type": "array", "items": {"type": "object"}},
        "counts": {"type": "object"},
        "findings": {"type": "array", "items": {"type": "object"}},
        "page": {"$ref": "#/$defs/page"},
        "validated": {"type": "boolean"}
      }
    },

    "req_artifact_list": {
      "type": "object",
      "required": ["job"],
      "additionalProperties": false,
      "properties": {"job": {"$ref": "#/$defs/job_id"}}
    },
    "res_artifact_list": {
      "type": "object",
      "required": ["job", "artifacts"],
      "additionalProperties": false,
      "properties": {
        "job": {"$ref": "#/$defs/job_id"},
        "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact_entry"}},
        "job_dir": {"type": "string"}
      }
    },

    "req_artifact_get": {
      "type": "object",
      "required": ["job", "path"],
      "additionalProperties": false,
      "properties": {
        "job": {"$ref": "#/$defs/job_id"},
        "path": {"type": "string", "minLength": 1, "description": "relative to the job directory, as reported by artifact.list"},
        "max_bytes": {"type": "integer", "minimum": 1, "maximum": 1048576},
        "encoding": {"type": "string", "enum": ["text", "base64"]}
      }
    },
    "res_artifact_get": {
      "type": "object",
      "required": ["job", "path", "encoding", "content", "size_bytes", "truncation"],
      "additionalProperties": false,
      "properties": {
        "job": {"$ref": "#/$defs/job_id"},
        "path": {"type": "string"},
        "encoding": {"type": "string", "enum": ["text", "base64"]},
        "content": {"type": "string"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "returned_bytes": {"type": "integer", "minimum": 0},
        "sha256": {"type": ["string", "null"]},
        "truncation": {"$ref": "#/$defs/truncation"}
      }
    }
  }
}
