// generated by tools/hal_fsm
// state bit order (bit 0 first): g1, g2, g4, g6
// state values are printed as bit vectors, most significant bit first
// solver: brute_force
// initial state: 0000
digraph "state register recovered from the netlist" {
  graph [rankdir="LR", labelloc="t", label="state register recovered from the netlist", fontname="Helvetica"];
  node [fontname="Helvetica", fontsize="10"];
  edge [fontname="Helvetica", fontsize="9"];

  "__entry__" [shape="point", width="0.1", label=""];
  "s0" [shape="doublecircle", style="filled", fillcolor="#dfefff", label="0000\n(0)"];
  "s3" [shape="circle", label="0011\n(3)"];
  "s9" [shape="circle", label="1001\n(9)"];
  "s5" [shape="circle", label="0101\n(5)"];
  "s1" [shape="circle", style="dashed", color="#909090", fontcolor="#606060", label="0001\n(1)"];
  "s2" [shape="circle", style="dashed", color="#909090", fontcolor="#606060", label="0010\n(2)"];
  "s4" [shape="circle", style="dashed", color="#909090", fontcolor="#606060", label="0100\n(4)"];
  "s6" [shape="circle", style="dashed", color="#909090", fontcolor="#606060", label="0110\n(6)"];
  "s7" [shape="circle", style="dashed", color="#909090", fontcolor="#606060", label="0111\n(7)"];
  "s8" [shape="circle", style="dashed", color="#909090", fontcolor="#606060", label="1000\n(8)"];
  "s10" [shape="circle", style="dashed", color="#909090", fontcolor="#606060", label="1010\n(10)"];
  "s11" [shape="circle", style="dashed", color="#909090", fontcolor="#606060", label="1011\n(11)"];
  "s12" [shape="circle", style="dashed", color="#909090", fontcolor="#606060", label="1100\n(12)"];
  "s13" [shape="circle", style="dashed", color="#909090", fontcolor="#606060", label="1101\n(13)"];
  "s14" [shape="circle", style="dashed", color="#909090", fontcolor="#606060", label="1110\n(14)"];
  "s15" [shape="circle", style="dashed", color="#909090", fontcolor="#606060", label="1111\n(15)"];

  "__entry__" -> "s0" [label="reset"];
  "s0" -> "s0" [label="otherwise"];
  "s0" -> "s3" [label="!i0 & counter == 9"];
  "s1" -> "s0" [label="otherwise"];
  "s2" -> "s0" [label="otherwise"];
  "s3" -> "s3" [label="otherwise"];
  "s3" -> "s9" [label="!i0 & counter == 2"];
  "s4" -> "s0" [label="otherwise"];
  "s5" -> "s0" [label="!i0 & counter == 4"];
  "s5" -> "s5" [label="otherwise"];
  "s6" -> "s0" [label="otherwise"];
  "s7" -> "s0" [label="otherwise"];
  "s8" -> "s0" [label="otherwise"];
  "s9" -> "s5" [label="!i0 & counter == 12"];
  "s9" -> "s9" [label="otherwise"];
  "s10" -> "s0" [label="otherwise"];
  "s11" -> "s0" [label="otherwise"];
  "s12" -> "s0" [label="otherwise"];
  "s13" -> "s0" [label="otherwise"];
  "s14" -> "s0" [label="otherwise"];
  "s15" -> "s0" [label="otherwise"];
}
