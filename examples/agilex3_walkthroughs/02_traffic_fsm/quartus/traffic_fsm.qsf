# traffic_fsm -- Quartus Prime Pro settings for the Agilex 3 walkthrough.
# Device / family / flow are the ones tools/hal_agilex documents for its
# fixtures, so the export lands inside the AGILEX_TENNM primitive coverage.

set_global_assignment -name FAMILY "Agilex 3"
set_global_assignment -name DEVICE A3CW135BM16AE6S
set_global_assignment -name TOP_LEVEL_ENTITY traffic_fsm
set_global_assignment -name VERILOG_FILE ../design.v
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files

# Keep every register on the plain (D, ENA, CLRN) tennm_ff configuration that
# hal_agilex models: no synchronous clear, no synchronous load.
set_global_assignment -name ALLOW_SYNCH_CTRL_USAGE OFF
set_global_assignment -name LAST_QUARTUS_VERSION "26.1.0 Pro Edition"
