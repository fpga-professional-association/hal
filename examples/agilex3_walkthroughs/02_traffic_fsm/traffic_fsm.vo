	.cout(),
	.shareout());

tennm_lcell_comb #(
  .extended_lut ("off"),
  .lut_mask (64'hAAAAAAAAAAAAAAAA),
  .shared_arith ("off"))
\hold~_wirecell (
// Equation(s):
// \hold~_wirecell_combout  = !hold

	.dataa(~hold),
	.datab(gnd),
	.datac(gnd),
	.datad(gnd),
	.datae(gnd),
	.dataf(gnd),
	.datag(gnd),
	.datah(gnd),
	.cin(gnd),
	.sharein(gnd),
