tennm_ff #(
  .is_wysiwyg ("true"),
  .power_up ("dont_care"))
\tick[2] (
	.clk(clk),
	.d(\i23~3_combout ),
	.asdata(vcc),
	.clrn(rst_n),
	.aload(gnd),
	.sclr(gnd),
	.sload(gnd),
	.ena(\hold~_wirecell_combout ),
	.sclr1(gnd),
	.devclrn(devclrn),
	.devpor(devpor),
	.q(tick[2]));

tennm_lcell_comb #(
  .extended_lut ("off"),
  .lut_mask (64'h0812400008124000),
  .shared_arith ("off"))
\reduce_nor_1~0 (
// Equation(s):
// \reduce_nor_1~0_combout  = ( tick[2] & ( (\state.S_RED~q  & (!\state.S_RED_YELLOW~q  & (!tick[0] & !tick[1]))) ) ) | ( !tick[2] & ( (!\state.S_RED~q  & (tick[0] & ( !\state.S_RED_YELLOW~q  ^ (tick[1])))) | (\state.S_RED~q  & (\state.S_RED_YELLOW~q  & 
// (!tick[0] & tick[1]))) ) )

	.dataa(~\state.S_RED~q ),
	.datab(~\state.S_RED_YELLOW~q ),
	.datac(~tick[0]),
	.datad(~tick[1]),
	.datae(~tick[2]),
	.dataf(gnd),
	.datag(gnd),
	.datah(gnd),
	.cin(gnd),
	.sharein(gnd),
	.combout(\reduce_nor_1~0_combout ),
	.sumout(),
	.cout(),
	.shareout());

tennm_lcell_comb #(
  .extended_lut ("off"),
  .lut_mask (64'h9440944094409440),
  .shared_arith ("off"))
\state.S_RED~0 (
// Equation(s):
// \state.S_RED~0_combout  = (!\state.S_RED~q  & (!\state.S_RED_YELLOW~q  & (!\state.S_YELLOW~q  & !\state.S_GREEN~q ))) | (\state.S_RED~q  & ( (!\state.S_RED_YELLOW~q  & ( !\state.S_YELLOW~q  ^ (!\state.S_GREEN~q ))) | (\state.S_RED_YELLOW~q  & 
// (!\state.S_YELLOW~q  & !\state.S_GREEN~q ))))

	.dataa(~\state.S_RED~q ),
	.datab(~\state.S_RED_YELLOW~q ),
	.datac(~\state.S_YELLOW~q ),
	.datad(~\state.S_GREEN~q ),
	.datae(gnd),
	.dataf(gnd),
	.datag(gnd),
	.datah(gnd),
	.cin(gnd),
	.sharein(gnd),
	.combout(\state.S_RED~0_combout ),
	.sumout(),
	.cout(),
	.shareout());

tennm_lcell_comb #(
  .extended_lut ("off"),
  .lut_mask (64'h000000005555C555),
  .shared_arith ("off"))
\state~6 (
// Equation(s):
// \state~6_combout  = ( \reduce_nor_1~0_combout  & ( \state.S_RED~0_combout  & ( (!hold & ( (!\i14~0_combout  & ( (!\state.S_YELLOW~q ))) | (\i14~0_combout  & (\state.S_RED~q )))) | (hold & (\state.S_RED~q )) ) ) ) | ( !\reduce_nor_1~0_combout  & ( 
// \state.S_RED~0_combout  & ( \state.S_RED~q  ) ) )

	.dataa(~\state.S_RED~q ),
	.datab(~\state.S_YELLOW~q ),
	.datac(~hold),
	.datad(~\i14~0_combout ),
	.datae(~\reduce_nor_1~0_combout ),
	.dataf(~\state.S_RED~0_combout ),
	.datag(gnd),
	.datah(gnd),
	.cin(gnd),
	.sharein(gnd),
	.combout(\state~6_combout ),
	.sumout(),
	.cout(),
	.shareout());

tennm_lcell_comb #(
  .extended_lut ("off"),
  .lut_mask (64'h000000003333A333),
  .shared_arith ("off"))
\state~7 (
// Equation(s):
// \state~7_combout  = ( \reduce_nor_1~0_combout  & ( \state.S_RED~0_combout  & ( (!hold & ( (!\i14~0_combout  & (!\state.S_RED~q )) | (\i14~0_combout  & ( (\state.S_RED_YELLOW~q ))))) | (hold & ( ((\state.S_RED_YELLOW~q )))) ) ) ) | ( 
// !\reduce_nor_1~0_combout  & ( \state.S_RED~0_combout  & ( \state.S_RED_YELLOW~q  ) ) )

	.dataa(~\state.S_RED~q ),
	.datab(~\state.S_RED_YELLOW~q ),
	.datac(~hold),
	.datad(~\i14~0_combout ),
	.datae(~\reduce_nor_1~0_combout ),
	.dataf(~\state.S_RED~0_combout ),
	.datag(gnd),
	.datah(gnd),
	.cin(gnd),
	.sharein(gnd),
	.combout(\state~7_combout ),
	.sumout(),
	.cout(),
	.shareout());

tennm_lcell_comb #(
  .extended_lut ("off"),
  .lut_mask (64'h0000000055553555),
  .shared_arith ("off"))
\state~8 (
// Equation(s):
// \state~8_combout  = ( \reduce_nor_1~0_combout  & ( \state.S_RED~0_combout  & ( (!hold & ( (!\i14~0_combout  & ( (\state.S_GREEN~q ))) | (\i14~0_combout  & (\state.S_YELLOW~q )))) | (hold & (\state.S_YELLOW~q )) ) ) ) | ( !\reduce_nor_1~0_combout  & ( 
// \state.S_RED~0_combout  & ( \state.S_YELLOW~q  ) ) )

	.dataa(~\state.S_YELLOW~q ),
	.datab(~\state.S_GREEN~q ),
	.datac(~hold),
	.datad(~\i14~0_combout ),
	.datae(~\reduce_nor_1~0_combout ),
	.dataf(~\state.S_RED~0_combout ),
	.datag(gnd),
	.datah(gnd),
	.cin(gnd),
	.sharein(gnd),
	.combout(\state~8_combout ),
	.sumout(),
	.cout(),
	.shareout());

tennm_lcell_comb #(
  .extended_lut ("off"),
  .lut_mask (64'h0000000033335333),
  .shared_arith ("off"))
\state~9 (
// Equation(s):
// \state~9_combout  = ( \reduce_nor_1~0_combout  & ( \state.S_RED~0_combout  & ( (!hold & ( (!\i14~0_combout  & (\state.S_RED_YELLOW~q )) | (\i14~0_combout  & ( (\state.S_GREEN~q ))))) | (hold & ( ((\state.S_GREEN~q )))) ) ) ) | ( !\reduce_nor_1~0_combout  
// & ( \state.S_RED~0_combout  & ( \state.S_GREEN~q  ) ) )

	.dataa(~\state.S_RED_YELLOW~q ),
	.datab(~\state.S_GREEN~q ),
	.datac(~hold),
	.datad(~\i14~0_combout ),
	.datae(~\reduce_nor_1~0_combout ),
	.dataf(~\state.S_RED~0_combout ),
	.datag(gnd),
	.datah(gnd),
	.cin(gnd),
	.sharein(gnd),
	.combout(\state~9_combout ),
	.sumout(),
	.cout(),
	.shareout());

tennm_lcell_comb #(
  .extended_lut ("off"),
  .lut_mask (64'h01FE01FE000001FE),
  .shared_arith ("off"))
\i23~0 (
// Equation(s):
// \i23~0_combout  = ( \i14~0_combout  & ( \reduce_nor_1~0_combout  & ( !tick[3] ^ (((!tick[0]) | ((!tick[1]) | (!tick[2])))) ) ) ) | ( \i14~0_combout  & ( !\reduce_nor_1~0_combout  & ( !tick[3] ^ (((!tick[0]) | ((!tick[1]) | (!tick[2])))) ) ) ) | ( 
// !\i14~0_combout  & ( !\reduce_nor_1~0_combout  & ( !tick[3] ^ (((!tick[0]) | ((!tick[1]) | (!tick[2])))) ) ) )

	.dataa(~tick[0]),
	.datab(~tick[1]),
	.datac(~tick[2]),
	.datad(~tick[3]),
	.datae(~\i14~0_combout ),
	.dataf(~\reduce_nor_1~0_combout ),
	.datag(gnd),
	.datah(gnd),
	.cin(gnd),
	.sharein(gnd),
	.combout(\i23~0_combout ),
	.sumout(),
	.cout(),
	.shareout());

tennm_lcell_comb #(
  .extended_lut ("off"),
  .lut_mask (64'hA2A2A2A2A2A2A2A2),
  .shared_arith ("off"))
\i23~1 (
// Equation(s):
// \i23~1_combout  = (!tick[0] & ( (!\reduce_nor_1~0_combout ) | (\i14~0_combout )))

	.dataa(~tick[0]),
	.datab(~\i14~0_combout ),
	.datac(~\reduce_nor_1~0_combout ),
	.datad(gnd),
	.datae(gnd),
	.dataf(gnd),
	.datag(gnd),
	.datah(gnd),
	.cin(gnd),
