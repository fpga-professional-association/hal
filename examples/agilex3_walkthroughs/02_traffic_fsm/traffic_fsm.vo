`timescale 1 ps/ 1 ps

module traffic_fsm (
	red,
	yellow,
	green,
	hold,
	clk,
	rst_n);
output 	red;
output 	yellow;
output 	green;
input 	hold;
input 	clk;
input 	rst_n;

wire gnd;
wire vcc;
wire unknown;

assign gnd = 1'b0;
assign vcc = 1'b1;
assign unknown = 1'bx;

tri1 devclrn;
tri1 devpor;
tri1 devoe;
wire \state.S_RED~q ;
wire \state.S_RED_YELLOW~q ;
wire \red~0_combout ;
wire \state.S_YELLOW~q ;
wire \yellow~0_combout ;
wire \state.S_GREEN~q ;
wire \i14~0_combout ;
wire \reduce_nor_1~0_combout ;
wire \state.S_RED~0_combout ;
wire \state~6_combout ;
wire \state~7_combout ;
wire \state~8_combout ;
wire \state~9_combout ;
wire \i23~0_combout ;
wire \i23~1_combout ;
wire \i23~2_combout ;
wire \i23~3_combout ;
wire \hold~_wirecell_combout ;
wire [3:0] tick;


tennm_ff #(
  .is_wysiwyg ("true"),
  .power_up ("low"))
\state.S_RED (
	.clk(clk),
	.d(\state~6_combout ),
	.asdata(vcc),
	.clrn(rst_n),
	.aload(gnd),
	.sclr(gnd),
	.sload(gnd),
	.ena(vcc),
	.sclr1(gnd),
	.devclrn(devclrn),
	.devpor(devpor),
	.q(\state.S_RED~q ));

tennm_ff #(
  .is_wysiwyg ("true"),
  .power_up ("low"))
\state.S_RED_YELLOW (
	.clk(clk),
	.d(\state~7_combout ),
	.asdata(vcc),
	.clrn(rst_n),
	.aload(gnd),
	.sclr(gnd),
	.sload(gnd),
	.ena(vcc),
	.sclr1(gnd),
	.devclrn(devclrn),
	.devpor(devpor),
	.q(\state.S_RED_YELLOW~q ));

tennm_lcell_comb #(
  .extended_lut ("off"),
  .lut_mask (64'hBBBBBBBBBBBBBBBB),
  .shared_arith ("off"))
\red~0 (
// Equation(s):
// \red~0_combout  = (!\state.S_RED~q ) | (\state.S_RED_YELLOW~q )

	.dataa(~\state.S_RED~q ),
	.datab(~\state.S_RED_YELLOW~q ),
	.datac(gnd),
	.datad(gnd),
	.datae(gnd),
	.dataf(gnd),
	.datag(gnd),
	.datah(gnd),
	.cin(gnd),
	.sharein(gnd),
	.combout(\red~0_combout ),
	.sumout(),
	.cout(),
	.shareout());

tennm_ff #(
  .is_wysiwyg ("true"),
  .power_up ("low"))
\state.S_YELLOW (
	.clk(clk),
	.d(\state~8_combout ),
	.asdata(vcc),
	.clrn(rst_n),
	.aload(gnd),
	.sclr(gnd),
	.sload(gnd),
	.ena(vcc),
	.sclr1(gnd),
	.devclrn(devclrn),
	.devpor(devpor),
	.q(\state.S_YELLOW~q ));

tennm_lcell_comb #(
  .extended_lut ("off"),
  .lut_mask (64'h7777777777777777),
  .shared_arith ("off"))
\yellow~0 (
// Equation(s):
// \yellow~0_combout  = (\state.S_YELLOW~q ) | (\state.S_RED_YELLOW~q )

	.dataa(~\state.S_RED_YELLOW~q ),
	.datab(~\state.S_YELLOW~q ),
	.datac(gnd),
	.datad(gnd),
	.datae(gnd),
	.dataf(gnd),
	.datag(gnd),
	.datah(gnd),
	.cin(gnd),
	.sharein(gnd),
	.combout(\yellow~0_combout ),
	.sumout(),
	.cout(),
	.shareout());

tennm_ff #(
  .is_wysiwyg ("true"),
  .power_up ("low"))
\state.S_GREEN (
	.clk(clk),
	.d(\state~9_combout ),
	.asdata(vcc),
	.clrn(rst_n),
	.aload(gnd),
	.sclr(gnd),
	.sload(gnd),
	.ena(vcc),
	.sclr1(gnd),
	.devclrn(devclrn),
	.devpor(devpor),
	.q(\state.S_GREEN~q ));

tennm_ff #(
  .is_wysiwyg ("true"),
  .power_up ("dont_care"))
\tick[3] (
	.clk(clk),
	.d(\i23~0_combout ),
	.asdata(vcc),
	.clrn(rst_n),
	.aload(gnd),
	.sclr(gnd),
	.sload(gnd),
	.ena(\hold~_wirecell_combout ),
	.sclr1(gnd),
	.devclrn(devclrn),
	.devpor(devpor),
	.q(tick[3]));

tennm_lcell_comb #(
  .extended_lut ("off"),
  .lut_mask (64'hB4B4B4B4B4B4B4B4),
  .shared_arith ("off"))
\i14~0 (
// Equation(s):
// \i14~0_combout  = !tick[3] ^ (((\state.S_RED~q  & !\state.S_GREEN~q )))

	.dataa(~\state.S_RED~q ),
	.datab(~\state.S_GREEN~q ),
	.datac(~tick[3]),
	.datad(gnd),
	.datae(gnd),
	.dataf(gnd),
	.datag(gnd),
	.datah(gnd),
	.cin(gnd),
	.sharein(gnd),
	.combout(\i14~0_combout ),
	.sumout(),
	.cout(),
	.shareout());

tennm_ff #(
  .is_wysiwyg ("true"),
  .power_up ("dont_care"))
\tick[0] (
	.clk(clk),
	.d(\i23~1_combout ),
	.asdata(vcc),
	.clrn(rst_n),
	.aload(gnd),
	.sclr(gnd),
	.sload(gnd),
	.ena(\hold~_wirecell_combout ),
	.sclr1(gnd),
	.devclrn(devclrn),
	.devpor(devpor),
	.q(tick[0]));

tennm_ff #(
  .is_wysiwyg ("true"),
  .power_up ("dont_care"))
\tick[1] (
	.clk(clk),
	.d(\i23~2_combout ),
	.asdata(vcc),
	.clrn(rst_n),
	.aload(gnd),
	.sclr(gnd),
