tennm_lcell_comb #(
  .extended_lut ("off"),
  .lut_mask (64'h6606660666066606),
  .shared_arith ("off"))
\i23~2 (
// Equation(s):
// \i23~2_combout  = (!\i14~0_combout  & (!\reduce_nor_1~0_combout  & ( !tick[0] ^ (!tick[1])))) | (\i14~0_combout  & ( !tick[0] ^ ((!tick[1]))))

	.dataa(~tick[0]),
	.datab(~tick[1]),
	.datac(~\i14~0_combout ),
	.datad(~\reduce_nor_1~0_combout ),
	.datae(gnd),
	.dataf(gnd),
	.datag(gnd),
	.datah(gnd),
	.cin(gnd),
	.sharein(gnd),
