// Equation(s):
// \i23~3_combout  = ( \reduce_nor_1~0_combout  & ( (\i14~0_combout  & ( !tick[2] ^ (((!tick[0]) | (!tick[1]))))) ) ) | ( !\reduce_nor_1~0_combout  & ( !tick[2] ^ (((!tick[0]) | (!tick[1]))) ) )

	.dataa(~tick[0]),
	.datab(~tick[1]),
	.datac(~tick[2]),
	.datad(~\i14~0_combout ),
	.datae(~\reduce_nor_1~0_combout ),
