  subgraph "level_1" {
    graph [rank="same"];

    "lvl_1" [shape="plaintext", style="", fontsize="11", fontcolor="#777777", label="level 1"];
    "g3" [shape="octagon", style="filled", fillcolor="#d6ecff", color="#2a5d8f", label="g3\n[tennm_lcell_comb]\nid 3"];
