# Quartus settings for the speck_toy walkthrough.
# Same device / family / flow as tools/hal_agilex/fixtures (see its README).
set_global_assignment -name FAMILY "Agilex 3"
set_global_assignment -name DEVICE A3CW135BM16AE6S
set_global_assignment -name TOP_LEVEL_ENTITY speck_toy
set_global_assignment -name VERILOG_FILE design.v
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files

# Keep the load/round selection out of the flip-flop's `sload` and `sclr`
# ports and inside the LUT logic instead.  Both are real tennm_ff ports but
# they are outside the configuration hal_agilex validated (see tools/hal_agilex,
# "Coverage"), so an export using them would be reported `unsupported`.  Same
# assignment, same reason, as walkthrough 06.
set_global_assignment -name ALLOW_SYNCH_CTRL_USAGE OFF

# The key schedule's l0 <- l1 <- l2 buffer is a three-deep 16-bit shift
# register, which is the shape Quartus may retarget onto a memory block.  A
# memory block is outside the validated primitive coverage; a flip-flop chain
# is inside it, and it is also the structure this walkthrough is about.
set_global_assignment -name AUTO_SHIFT_REGISTER_RECOGNITION OFF
