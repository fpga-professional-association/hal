	.clrn(rst_n),
	.aload(gnd),
	.sclr(gnd),
	.sload(gnd),
	.ena(\duty_we~0_combout ),
	.sclr1(gnd),
	.devclrn(devclrn),
	.devpor(devpor),
	.q(duty[0]));

tennm_lcell_comb #(
  .extended_lut ("off"),
  .lut_mask (64'hAAAAAAAAAAAAAAAA),
  .shared_arith ("off"))
\cnt[0]~0 (
// Equation(s):
// \cnt[0]~0_combout  = !cnt[0]

	.dataa(~cnt[0]),
	.datab(gnd),
	.datac(gnd),
	.datad(gnd),
	.datae(gnd),
	.dataf(gnd),
	.datag(gnd),
	.datah(gnd),
	.cin(gnd),
	.sharein(gnd),
	.combout(\cnt[0]~0_combout ),
	.sumout(),
	.cout(),
	.shareout());

tennm_lcell_comb #(
  .extended_lut ("off"),
  .lut_mask (64'hAAAAAAAAAAAAAAAA),
  .shared_arith ("off"))
\LessThan_0~1_wirecell (
// Equation(s):
// \LessThan_0~1_wirecell_combout  = !\LessThan_0~1_sumout 

	.dataa(~\LessThan_0~1_sumout ),
	.datab(gnd),
	.datac(gnd),
	.datad(gnd),
	.datae(gnd),
	.dataf(gnd),
	.datag(gnd),
	.datah(gnd),
	.cin(gnd),
	.sharein(gnd),
	.combout(\LessThan_0~1_wirecell_combout ),
	.sumout(),
	.cout(),
	.shareout());

assign pwm_out = \LessThan_0~1_wirecell_combout ;

assign period_tick = \reduce_nor_1~combout ;

endmodule
