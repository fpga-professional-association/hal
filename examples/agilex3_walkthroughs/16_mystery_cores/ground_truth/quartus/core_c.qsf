# Quartus settings for walkthrough 16's core_c.
# Same device / family / flow as tools/hal_agilex/fixtures (see its README) and
# as every other walkthrough in the series.
set_global_assignment -name FAMILY "Agilex 3"
set_global_assignment -name DEVICE A3CW135BM16AE6S
set_global_assignment -name TOP_LEVEL_ENTITY core_c
set_global_assignment -name VERILOG_FILE core_c.v
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files

# Keep the load selection out of the flip-flop's `sload` and `sclr` ports and
# inside the LUT logic instead.  Both are real tennm_ff ports but they are
# outside the configuration hal_agilex validated (see tools/hal_agilex,
# "Coverage"), so an export using them would be reported `unsupported`.
set_global_assignment -name ALLOW_SYNCH_CTRL_USAGE OFF

# This design's state is three long shift registers -- precisely the shape
# Quartus retargets onto a memory block.  A memory block is outside the
# validated primitive coverage, and the flip-flop chain is also the structure
# the exercise is about, so shift-register inference is off.
set_global_assignment -name AUTO_SHIFT_REGISTER_RECOGNITION OFF
