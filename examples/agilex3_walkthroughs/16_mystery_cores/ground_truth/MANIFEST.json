          "id": "a-no-arithmetic",
          "statement": "the round contains no carry chain at all"
        },
        {
          "id": "a-parity-layer",
          "statement": "forty cells, each the parity of exactly five state bits, with pairwise-disjoint sources"
        },
        {
          "id": "a-nonlinear-layer",
          "statement": "a nonlinear layer sits between the register bank and itself, so the next-state cones cannot be enumerated"
        },
        {
          "id": "a-lane-geometry",
