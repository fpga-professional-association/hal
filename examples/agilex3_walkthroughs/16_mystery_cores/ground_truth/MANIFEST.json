        {
          "id": "b-absorbing-chain",
          "statement": "an eight-stage shift register whose head reads a primary input, so it absorbs data instead of feeding itself"
        },
        {
          "id": "b-counter-chain",
          "statement": "a sixteen-bit carry chain that adds the constant 1 -- a counter, not an adder over two operands"
        },
        {
