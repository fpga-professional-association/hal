# Quartus Prime Pro Edition 26.1 settings for the 03_uart_tx walkthrough.
#
# Same device and flow as the tools/hal_agilex fixtures, so the export lands in
# the primitive coverage that AGILEX_TENNM.hgl models.

set_global_assignment -name FAMILY "Agilex 3"
set_global_assignment -name DEVICE A3CW135BM16AE6S
set_global_assignment -name TOP_LEVEL_ENTITY uart_tx
set_global_assignment -name VERILOG_FILE ../design.v
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files

# Keep the design inside the modelled primitive set: no inferred shift-register
# chains, no inferred RAM, no inferred DSP.  With a 10-bit parallel-loadable
# shift register none of these would fire anyway, but stating it makes the
# export reproducible instead of dependent on inference heuristics.
set_global_assignment -name AUTO_SHIFT_REGISTER_RECOGNITION OFF
set_global_assignment -name AUTO_RAM_RECOGNITION OFF
set_global_assignment -name AUTO_DSP_RECOGNITION OFF

# Keep the flip-flops in the one configuration hal_agilex has validated:
# asynchronous clear only, with aload/sload/sclr/sclr1 tied off.  Without this
# Quartus maps the "counter parks at zero while idle" branch onto the register's
# synchronous-clear pin, which is outside the modelled coverage and makes the
# export un-importable.
set_global_assignment -name ALLOW_SYNCH_CTRL_USAGE OFF
