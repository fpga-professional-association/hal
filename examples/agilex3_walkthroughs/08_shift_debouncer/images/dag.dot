  subgraph "cluster_legend" {
    graph [label="legend", style="rounded", color="#bbbbbb", bgcolor="#fcfcfc", fontname="Helvetica", fontsize="11", labelloc="t"];

    "legend_comb" [fontsize="9", shape="box", style="rounded,filled", fillcolor="#f4f4f4", color="#555555", label="combinational\ngate"];
    "legend_seq" [fontsize="9", shape="box", style="filled", fillcolor="#dbe9f6", color="#2a5d8f", penwidth="2", label="flip-flop /\nlatch"];
    "legend_io" [fontsize="9", shape="octagon", style="filled", fillcolor="#d6ecff", color="#2a5d8f", label="primary I/O"];
    "legend_tie0" [shape="circle", style="filled", fillcolor="#e8e8e8", color="#8a8a8a", width="0.28", height="0.28", fixedsize="true", fontsize="10", margin="0", label="0"];
    "legend_tie1" [shape="circle", style="filled", fillcolor="#fff2cc", color="#bf9000", width="0.28", height="0.28", fixedsize="true", fontsize="10", margin="0", label="1"];
    "legend_tie_note" [shape="plaintext", style="", fontsize="9", fontcolor="#555555", label="constant tie-off,\none stub per sink"];
    "legend_net_a" [shape="point", width="0.06", color="#777777", fillcolor="#777777", style="filled", label=""];
    "legend_net_b" [shape="point", width="0.06", color="#777777", fillcolor="#777777", style="filled", label=""];
    "legend_cut_a" [shape="point", width="0.06", color="#c0392b", fillcolor="#c0392b", style="filled", label=""];
    "legend_cut_b" [shape="point", width="0.06", color="#c0392b", fillcolor="#c0392b", style="filled", label=""];
    "legend_cycle" [fontsize="9", shape="box", style="rounded,filled", color="#c0392b", penwidth="3", fillcolor="#fdecea", label="combinational\nloop"];
    "legend_levels" [shape="plaintext", style="", fontsize="9", fontcolor="#555555", label="level 0 (inputs, tie-offs, register outputs)\non the left; depth increases to the right"];

    "legend_net_a" -> "legend_net_b" [fontsize="9", color="#777777", label="net"];
    "legend_cut_a" -> "legend_cut_b" [fontsize="9", style="dashed", color="#c0392b", label="cut at register"];
  }

