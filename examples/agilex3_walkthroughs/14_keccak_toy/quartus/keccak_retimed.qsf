# Quartus settings for the keccak_retimed counterfactual export (section 10).
# Identical to keccak_toy.qsf apart from the source file and the entity name:
# the point of the counterfactual is that only the RTL changed.
set_global_assignment -name FAMILY "Agilex 3"
set_global_assignment -name DEVICE A3CW135BM16AE6S
set_global_assignment -name TOP_LEVEL_ENTITY keccak_retimed
set_global_assignment -name VERILOG_FILE retimed.v
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files

set_global_assignment -name ALLOW_SYNCH_CTRL_USAGE OFF
