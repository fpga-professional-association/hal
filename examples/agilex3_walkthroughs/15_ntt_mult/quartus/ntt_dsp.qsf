# Quartus settings for the ntt_dsp counterfactual export (guide section 10).
#
# The *same* design.v, the same device, the same flow.  The only differences
# are that `ALLOW_DSP` is defined -- which switches off the `multstyle = "logic"`
# attribute on the module -- and that the two DSP assignments below are absent.
# Everything a reverse engineer would call "the design" is identical; what
# changes is which primitive the 9 x 9 modular multiplier ends up in, and
# therefore whether the multiplier is visible at all.
#
#   (absent) set_global_assignment -name AUTO_DSP_RECOGNITION OFF
#   (absent) set_global_assignment -name DSP_BLOCK_BALANCING "LOGIC ELEMENTS"
set_global_assignment -name FAMILY "Agilex 3"
set_global_assignment -name DEVICE A3CW135BM16AE6S
set_global_assignment -name TOP_LEVEL_ENTITY ntt_mult
set_global_assignment -name VERILOG_FILE design.v
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files

set_global_assignment -name ALLOW_SYNCH_CTRL_USAGE OFF
set_global_assignment -name VERILOG_MACRO "ALLOW_DSP=1"
