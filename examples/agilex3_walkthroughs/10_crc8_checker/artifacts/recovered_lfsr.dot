digraph recovered_lfsr {
  rankdir=LR;
  graph [fontname="Helvetica", labelloc=t, label="recovered: 8-bit CRC LFSR, polynomial 0x07\nx^8 + x^2 + x + 1"];
  node [fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9];
  din [shape=invhouse, style=filled, fillcolor="#ffe9b0", label="port_i0\n(serial data in)"];
  fb [shape=circle, width=0.32, style=filled, fillcolor="#ffd0d0", label="+"];
  b0 [shape=box, style="filled,rounded", fillcolor="#d8ecff", label="bit 0\nport_o0(0)"];
  b1 [shape=box, style="filled,rounded", fillcolor="#d8ecff", label="bit 1\nport_o0(1)"];
  b2 [shape=box, style="filled,rounded", fillcolor="#d8ecff", label="bit 2\nport_o0(2)"];
  b3 [shape=box, style="filled,rounded", fillcolor="#eeeeee", label="bit 3\nport_o0(3)"];
  b4 [shape=box, style="filled,rounded", fillcolor="#eeeeee", label="bit 4\nport_o0(4)"];
  b5 [shape=box, style="filled,rounded", fillcolor="#eeeeee", label="bit 5\nport_o0(5)"];
  b6 [shape=box, style="filled,rounded", fillcolor="#eeeeee", label="bit 6\nport_o0(6)"];
  b7 [shape=box, style="filled,rounded", fillcolor="#eeeeee", label="bit 7\nport_o0(7)"];
  x1 [shape=circle, width=0.28, style=filled, fillcolor="#ffd0d0", label="+"];
  b0 -> x1;
  x1 -> b1;
  fb -> x1 [color="#c04040"];
  x2 [shape=circle, width=0.28, style=filled, fillcolor="#ffd0d0", label="+"];
  b1 -> x2;
  x2 -> b2;
  fb -> x2 [color="#c04040"];
  b2 -> b3;
  b3 -> b4;
  b4 -> b5;
  b5 -> b6;
  b6 -> b7;
  fb -> b0 [color="#c04040"];
  din -> fb;
  b7 -> fb [color="#c04040", label="feedback"];
  zero [shape=house, style=filled, fillcolor="#d6f5d6", label="port_o1\n(state == 0)"];
  b0 -> zero [style=dotted, color="#60a060", arrowsize=0.5];
  b1 -> zero [style=dotted, color="#60a060", arrowsize=0.5];
  b2 -> zero [style=dotted, color="#60a060", arrowsize=0.5];
  b3 -> zero [style=dotted, color="#60a060", arrowsize=0.5];
  b4 -> zero [style=dotted, color="#60a060", arrowsize=0.5];
  b5 -> zero [style=dotted, color="#60a060", arrowsize=0.5];
  b6 -> zero [style=dotted, color="#60a060", arrowsize=0.5];
  b7 -> zero [style=dotted, color="#60a060", arrowsize=0.5];
}