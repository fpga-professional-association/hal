  "vendor_tool": "Quartus Prime Pro Edition",
  "quartus_version": "Version 26.1.0 Build 110 03/26/2026 SC Pro Edition",
  "quartus_install": "C:/altera_pro/26.1 (Windows)",
  "top_level_entity": "crc8_checker",
  "export_stage": "post-synthesis (synthesized snapshot; no fitting was run)",
  "export_flow": [
    "quartus_sh -t build.tcl",
    "quartus_syn crc8_checker -c crc8_checker",
