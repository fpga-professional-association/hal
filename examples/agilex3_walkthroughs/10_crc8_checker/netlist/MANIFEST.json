    "set_global_assignment -name VERILOG_FILE design.v",
    "set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files"
  ],
  "regenerate": [
    "mkdir <scratch> && cd <scratch>",
    "cp ../design.v ../quartus/build.tcl .",
    "quartus_sh -t build.tcl",
    "quartus_syn crc8_checker -c crc8_checker",
    "quartus_eda --simulation --format=verilog --tool=questasim --output_directory=simulation crc8_checker -c crc8_checker",
    "cp simulation/crc8_checker.vo <this dir>",
    "python tools/hal_agilex import <this dir>/crc8_checker.vo -o <this dir>/netlist.hal.v",
    "python ../anonymize.py <this dir>/netlist.hal.v <this dir>/netlist.anon.hal.v"
  ],
  "contents": {
